[Desktop Entry]
Type=Application
Name=Codex
Comment=Open the Codex coding assistant in Kitty
Exec=kitty --class codex --title Codex sh -c "exec ~/.local/bin/codex-launch"
TryExec=kitty
Icon=codex
Terminal=false
StartupNotify=false
Categories=Development;ConsoleOnly;
Keywords=ai;coding;assistant;openai;terminal;
