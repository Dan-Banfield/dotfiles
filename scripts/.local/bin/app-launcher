#!/usr/bin/env python3
"""Open the resident Walker, starting its services when needed."""

import os
import socket
import subprocess
import sys
import time


def activate(socket_path):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(0.1)
            connection.connect(socket_path)
        return True
    except OSError:
        return False


def main():
    if len(sys.argv) == 1:
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        socket_path = os.path.join(runtime_dir, "walker", "walker.sock")
        if activate(socket_path):
            return 0

        # The session/bar may not include ~/.local/bin in PATH. Use the helper's
        # full path, import this session's display, and recover stopped services.
        try:
            result = subprocess.run([os.path.expanduser("~/.local/bin/launcher-start")])
        except OSError as error:
            print(f"app-launcher: could not start services: {error}", file=sys.stderr)
            return 127
        if result.returncode != 0:
            return result.returncode

        # systemd starts the process before GTK finishes creating its socket.
        # Wait only after a cold start; successful connections open the panel.
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            if activate(socket_path):
                return 0
            time.sleep(0.025)
        print(
            "app-launcher: Walker did not become ready. Check "
            "'journalctl --user -u walker.service -u elephant.service -b'.",
            file=sys.stderr,
        )
        return 1

    try:
        os.execvp("walker", ["walker", *sys.argv[1:]])
    except FileNotFoundError:
        print("app-launcher: Walker is not installed. See ~/dotfiles/README.md.", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
