#!/usr/bin/env bash
set -euo pipefail

# Activate the resident GTK application without importing Python/GTK again.
if (($# == 0)) && command -v gdbus >/dev/null 2>&1; then
  if gdbus call --session --timeout 1 --dest dev.dotfiles.SessionMenu \
      --object-path /dev/dotfiles/SessionMenu \
      --method org.freedesktop.Application.Activate '{}' >/dev/null 2>&1; then
    exit 0
  fi
fi

exec python "${XDG_CONFIG_HOME:-$HOME/.config}/session-menu/menu.py" "$@"
